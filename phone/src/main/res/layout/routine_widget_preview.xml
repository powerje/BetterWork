<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp"
    android:background="?android:attr/colorBackground">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Japanese Walk" android:textSize="16sp" android:textColor="?android:attr/textColorPrimary" />
    <Button android:layout_width="match_parent" android:layout_height="48dp"
        android:text="Start" android:textAllCaps="false" />
</LinearLayout>
